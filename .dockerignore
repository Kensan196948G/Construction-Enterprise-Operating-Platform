# ── Large directories that are NOT part of the platform image ──────────────
# integrations/ is ~68 MB of snapshot repositories; shipping them bloats the
# Docker build context and CI cache with no runtime benefit.
integrations

# .omo/ contains agent run-continuation session files that should never be
# shipped inside a production image.
.omo

# ── Version control ───────────────────────────────────────────────────────
.git
.gitignore

# ── Dependencies ──────────────────────────────────────────────────────────
node_modules

# ── Build output (re-created inside image by tsc) ─────────────────────────
dist

# ── Test coverage ─────────────────────────────────────────────────────────
coverage

# ── Logs ───────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
pnpm-debug.log*

# ── Environment secrets ───────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Editor / OS artefacts ─────────────────────────────────────────────────
.DS_Store
*.swp
*.swo
Thumbs.db

# ── Legacy source material ────────────────────────────────────────────────
legacy-projects

# ── Claude / dev-only tooling ─────────────────────────────────────────────
.claude
CLAUDE.md

# ── Large / irrelevant source material ────────────────────────────────────
webui
docs
reports
examples
deploy
state.json
.coderabbit.yaml
SECURITY.md

# ── Large markdown files ──────────────────────────────────────────────────
CHANGELOG.md
