# Copy this to /etc/cdx-agent/agent.env on the device and adjust per profile.
# Permissions: 0640 root:cdx-agent

CDX_API_ENDPOINT=https://central.cdx.local/api/v1
CDX_PROFILE=standard
CDX_SPOOL_PATH=/var/lib/cdx-agent/spool/outbox.jsonl

# device_id: prefer leaving unset and relying on /etc/machine-id.
# Provisioning tooling writes the shared secret to /etc/cdx-agent/shared_secret
# (mode 0600) instead of placing it here.
