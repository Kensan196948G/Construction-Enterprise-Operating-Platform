# Construction DX OS — local development environment variables
# Copy this file to .env and fill in the values.
#
#   cp .env.example .env
#
# .env is in .gitignore — never commit real secrets.

# ---- cdx-server (required) --------------------------------------------------

# Registration token — used to provision new devices via POST /api/v1/devices/register
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
CDX_REGISTRATION_TOKEN=change-me-generate-a-random-token-here

# ---- cdx-server (optional tuning) ------------------------------------------

# Rate limiting (set to "false" to disable entirely in dev)
CDX_RATE_LIMIT_ENABLED=true
CDX_RATE_LIMIT_HEARTBEAT_PER_MIN=10
CDX_RATE_LIMIT_INVENTORY_PER_HOUR=3

# ---- Phase 2: PostgreSQL ----------------------------------------------------
# Required when using docker-compose (postgres service is now enabled by default).
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=change-me-generate-a-random-password-here

# DATABASE_URL is constructed automatically by docker-compose from POSTGRES_PASSWORD.
# Set this directly when connecting to an external PostgreSQL instance.
#
# Use asyncpg driver for the runtime (async storage layer, Loop 60-61):
# DATABASE_URL=postgresql+asyncpg://cdx:PASSWORD@localhost/cdx
#
# Alembic auto-converts asyncpg→psycopg2 (Loop 70 / Issue 0032), so the same
# DATABASE_URL works for both `alembic upgrade head` and the FastAPI runtime.

# ---- Phase 2: PostgreSQL connection pool (optional tuning) ------------------
# Controls SQLAlchemy connection pool when DATABASE_URL is set.
# CDX_DB_POOL_SIZE=5
# CDX_DB_MAX_OVERFLOW=10
# CDX_DB_POOL_RECYCLE=300
# CDX_DB_POOL_TIMEOUT=30

# ---- Phase 4a: Admin UI authentication --------------------------------------
# Enable HTTP Basic Auth on /admin (leave CDX_ADMIN_TOKEN unset for dev bypass).
# CDX_ADMIN_TOKEN=change-me-generate-a-random-token-here
# CDX_ADMIN_ENABLED=true

# ---- Phase 5b: OIDC authentication (optional) --------------------------------
# Set AUTH_BACKEND=oidc to use OIDC JWT Bearer tokens for /admin.
# AUTH_BACKEND=oidc
# OIDC_DISCOVERY_URL=https://login.microsoftonline.com/{tenant}/v2.0
# OIDC_CLIENT_ID=your-client-id
# OIDC_JWKS_CACHE_TTL=3600

# ---- Phase 4b: Redis rate limiting (optional) --------------------------------
# Set REDIS_URL to use Redis sliding-window rate limiting (requires redis server).
# REDIS_URL=redis://localhost:6379/0

# ---- Serial-scan OCR pipeline (GMSV0002 SMB → easyocr) ----------------------
#
# SERIAL_SCAN_MOCK=1  → mock mode (no real OCR, no SMB mount needed) [default]
# SERIAL_SCAN_MOCK=0  → production OCR (requires easyocr + SMB mount)
#
# Path to SMB-mounted scan folder:
#
#   Linux (SMB cifs mount via /etc/fstab):
#     SERIAL_SCAN_PATH=/mnt/gmsv0002-serial
#     Setup: //GMSV0002/cdx-serial-scans → /mnt/gmsv0002-serial
#            credentials file: /etc/cdx-smb.creds (chmod 600)
#
#   Windows 11 (domain-joined to mirai.local — no credentials needed):
#     SERIAL_SCAN_PATH=//GMSV0002/cdx-serial-scans
#     Windows authenticates automatically via Kerberos (MIRAI domain).
#
#   Windows 11 (mapped drive, e.g. Z:):
#     SERIAL_SCAN_PATH=Z:/cdx-serial-scans
#     Setup: net use Z: \\GMSV0002\cdx-serial-scans /persistent:yes
#
# Supported image formats: JPEG, PNG, HEIC (iPhone default), BMP, TIFF
# HEIC support requires: pip install ".[ocr]"  (includes pillow-heif)
#
SERIAL_SCAN_MOCK=1
# SERIAL_SCAN_PATH=/mnt/gmsv0002-serial          # Linux
# SERIAL_SCAN_PATH=//GMSV0002/cdx-serial-scans   # Windows (domain-joined)
# SERIAL_SCAN_PATH=Z:/cdx-serial-scans           # Windows (mapped drive)
