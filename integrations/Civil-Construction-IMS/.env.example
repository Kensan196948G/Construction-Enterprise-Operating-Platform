# Database
DATABASE_URL="postgresql://ims_user:ims_pass@localhost:5432/civil_ims_db"

# Auth (NextAuth.js)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-random-secret"

# Azure Entra ID (OIDC)
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# API
API_BASE_URL="http://localhost:4000"
API_SECRET_KEY="change-this-api-secret"

# File Storage (S3-compatible / MinIO for dev)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="civil-ims-files"
S3_REGION="us-east-1"

# Notifications
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
TEAMS_WEBHOOK_URL=""

# Application
APP_ENV="development"
LOG_LEVEL="debug"
