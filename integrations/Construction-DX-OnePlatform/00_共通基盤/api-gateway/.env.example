# Construction DX 統合APIゲートウェイ — 環境変数サンプル
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
ENV=development
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# レート制限
RATE_LIMIT_PER_MIN=600
RATE_LIMIT_STORAGE_URI=memory://
# 本番では redis 推奨:
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379/1

# バックエンド (各部門API)
SITE_API_URL=http://localhost:8101
SAFETY_API_URL=http://localhost:8102
ITSM_API_URL=http://localhost:8103
PROCUREMENT_API_URL=http://localhost:8104
SALES_API_URL=http://localhost:8105

# 依存インフラ (readiness)
POSTGRES_URL=postgresql://cdx:cdx@localhost:5432/cdx
REDIS_URL=redis://localhost:6379/0
ELASTICSEARCH_URL=http://localhost:9200

# プロキシ
PROXY_TIMEOUT_SECONDS=30

# cdx_auth (Entra ID) 設定はここに追加。
# AZURE_TENANT_ID=...
# AZURE_CLIENT_ID=...
# AZURE_CLIENT_SECRET=...
