[Unit]
Description=Construction DX One Platform WebUI
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/Construction-DX-OnePlatform
ExecStart=/opt/Construction-DX-OnePlatform/scripts/cdx-portal-up.sh
ExecStop=/usr/bin/docker compose stop cdx-portal
RemainAfterExit=yes
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
