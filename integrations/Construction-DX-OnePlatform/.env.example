# =========================================================
# Construction DX One Platform — Environment Variables
# Copy this file to `.env` and fill in real values.
# Never commit `.env`.
# =========================================================

# ------ Common ------
APP_ENV=development
LOG_LEVEL=INFO
TZ=Asia/Tokyo

# ------ PostgreSQL ------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=construction_dx
POSTGRES_USER=cdx_user
POSTGRES_PASSWORD=change_me
POSTGRES_SSL_MODE=disable

# ------ Redis ------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ------ Elasticsearch ------
ELASTIC_HOST=elasticsearch
ELASTIC_PORT=9200
ELASTIC_USER=elastic
ELASTIC_PASSWORD=change_me

# ------ Entra ID (Azure AD) ------
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=change_me
ENTRA_REDIRECT_URI=http://localhost:8080/auth/callback
ENTRA_AUTHORITY=https://login.microsoftonline.com/${ENTRA_TENANT_ID}

# ------ HENNGE SSO ------
# 3つすべてを設定すると shared-auth が HENNGE 発行トークンも受け入れる
HENNGE_ISSUER=https://your-tenant.hennge.com
HENNGE_JWKS_URI=https://your-tenant.hennge.com/.well-known/jwks.json
HENNGE_AUDIENCE=construction-dx-hennge
HENNGE_CLIENT_ID=change_me
HENNGE_CLIENT_SECRET=change_me

# ------ Azure OpenAI ------
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=change_me
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ------ JWT ------
JWT_ALGORITHM=RS256
JWT_AUDIENCE=construction-dx
JWT_ISSUER=https://login.microsoftonline.com/${ENTRA_TENANT_ID}/v2.0
JWT_PUBLIC_KEY_CACHE_TTL=3600

# ------ Object Storage (MinIO) ------
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=cdx_minio
S3_SECRET_KEY=change_me
S3_BUCKET_PHOTOS=construction-photos
S3_BUCKET_DOCS=construction-docs

# ------ API Gateway ------
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
GATEWAY_RATE_LIMIT_PER_MIN=600

# ------ FortiGate / Cisco (ITSM) ------
FORTIGATE_SYSLOG_PORT=5514
CISCO_SNMP_COMMUNITY=change_me
CISCO_SNMPV3_USER=cdx_snmp

# ------ Monitoring ------
ZABBIX_URL=http://zabbix-server:80
GRAFANA_URL=http://grafana:3000
WAZUH_URL=https://wazuh:55000
