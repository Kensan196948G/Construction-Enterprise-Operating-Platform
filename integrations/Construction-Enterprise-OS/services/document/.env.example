# Environment variables for Construction-Enterprise-OS Document Service
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8001
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://construction-os:construction-os_dev@localhost:5432/construction-os

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=construction-enterprise-os-documents
MINIO_SECURE=false
MAX_UPLOAD_SIZE_MB=500

# JWT (Auth Service 発行トークン検証用)
JWT_PUBLIC_KEY=dev-only-do-not-use-in-production

# CORS
CORS_ORIGINS=["http://localhost:3000"]
