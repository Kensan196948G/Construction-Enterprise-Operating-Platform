# Environment variables for Construction-Enterprise-OS API Gateway
ENVIRONMENT=development
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=9000
DEBUG=true

# JWT Public Key for token validation (must match auth service key)
JWT_PUBLIC_KEY=dev-only-do-not-use-in-production
JWT_ALGORITHM=HS256

# Rate limiting
RATE_LIMIT_PER_MINUTE=100

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Upstream services (JSON string)
UPSTREAM_SERVICES={"^/api/v1/auth": "http://localhost:8000", "^/api/v1/users": "http://localhost:8000", "^/api/v1/roles": "http://localhost:8000", "^/api/v1/permissions": "http://localhost:8000", "^/api/v1/api-clients": "http://localhost:8000", "^/api/v1/audit-logs": "http://localhost:8000", "^/api/v1/documents": "http://localhost:8001", "^/api/v1/workflow": "http://localhost:8002", "^/api/v1/gis": "http://localhost:8003", "^/api/v1/iot": "http://localhost:8004", "^/api/v1/ai": "http://localhost:8005", "^/api/v1/search": "http://localhost:8006"}
