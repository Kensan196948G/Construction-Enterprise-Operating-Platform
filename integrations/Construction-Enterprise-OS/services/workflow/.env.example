# Environment variables for Construction-Enterprise-OS Workflow Service
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8001
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://construction-os:construction-os_dev@localhost:5432/construction-os

# JWT (本番では必ず強力な鍵を設定すること)
JWT_SECRET_KEY=dev-only-do-not-use-in-production
JWT_ALGORITHM=HS256

# CORS
CORS_ORIGINS=["http://localhost:3000"]
