# ==============================================================================
# Construction-Enterprise-OS — Windows 本番環境変数
# Usage: copy .env.windows .env (then edit secrets below)
# ==============================================================================

# ── Host IP (Windows Ethernet) ──────────────────────────────────────────────
HOST_IP=172.23.10.251

# ── Port conflict overrides (Windows — avoids clashes with other running containers)
# 5432 used by helpdesk-autostart-postgres-1
POSTGRES_HOST_PORT=15440
# 8000 used by itsm-backend
AUTH_HOST_PORT=18100
# 8003 used by wmcdss-backend
GIS_HOST_PORT=18103

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=construction-os
POSTGRES_PASSWORD=construction-os_dev
POSTGRES_DB=construction-os
DATABASE_URL=postgresql://construction-os:construction-os_dev@postgres:5432/construction-os
TIMESCALE_URL=postgresql://construction-os:construction-os_dev@timescaledb:5432/construction-os_ts

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=construction-os
RABBITMQ_DEFAULT_PASS=construction-os_dev
RABBITMQ_URL=amqp://construction-os:construction-os_dev@rabbitmq:5672/

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── Elasticsearch ─────────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://elasticsearch:9200

# ── MinIO (Object Storage) ────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# IMPORTANT: 本番では必ず変更すること。生成例:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production-generate-with-python-secrets
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── API Gateway ───────────────────────────────────────────────────────────────
GATEWAY_PORT=9000

# ── Frontend ──────────────────────────────────────────────────────────────────
# Build-time (baked into bundle): ホストのIPとポートを指定
NEXT_PUBLIC_API_GATEWAY=http://172.23.10.251:9000
# Runtime (Docker): コンテナ内サービス名で通信
API_GATEWAY=http://gateway:9000
NEXT_TELEMETRY_DISABLED=1

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=docker
