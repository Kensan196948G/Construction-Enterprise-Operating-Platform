# Environment variables for Construction-Enterprise-OS Autonomous Service
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8010
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://construction-os:construction-os_dev@localhost:5432/construction-os

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# JWT (本番では必ず強力な鍵を設定すること)
JWT_PUBLIC_KEY=dev-only-do-not-use-in-production
JWT_ALGORITHM=HS256
