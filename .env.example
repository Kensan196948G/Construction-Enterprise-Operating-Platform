# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate a secure random key with:
#   node -e "import('node:crypto').then(c => console.log(c.randomBytes(32).toString('hex')))"
# or:
#   openssl rand -hex 32
API_KEY=<generate-with-crypto>

# Separate high-privilege key for admin operations.
API_KEY_ADMIN=<admin-key>

# ─── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Platform identity ───────────────────────────────────────────────────────
PLATFORM_NAME=Construction Enterprise Operating Platform

# ─── Future: Persistent storage ──────────────────────────────────────────────
# Uncomment and configure when a real database is introduced.
# DATABASE_URL=postgresql://user:password@localhost:5432/ceop

# ─── Future: HMAC signing secret ─────────────────────────────────────────────
# Used to sign and verify API keys in production.
# API_SIGNING_SECRET=<generate-with-crypto>

# ─── Graceful shutdown ────────────────────────────────────────────────────────
SHUTDOWN_TIMEOUT_MS=10000
