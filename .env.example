# ─── CEOP Environment Variables ──────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit a .env file containing real secrets.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── JWT Signing Secret (REQUIRED in production) ──────────────────────────────
# Must be at least 32 bytes. Generate with:
#   openssl rand -hex 32
# or:
#   node -e "import('node:crypto').then(c => console.log(c.randomBytes(32).toString('hex')))"
#
# If unset in development, a random ephemeral secret is generated per process.
# In production (NODE_ENV=production), the app refuses to start without this.
#
# NEVER copy a placeholder value here — the app will accept any 32+ byte string.
# Leave this commented out or blank so it MUST be set explicitly before use.
# CEOP_JWT_SECRET=

# ─── Persistence: SQLite (recommended for production single-node) ─────────────
# Path to the SQLite database file.
# When set, the file persistence layer is used instead of in-memory.
# Ensure the directory is writable and backed by a persistent volume.
#
# Example (Docker): mount a named volume to /data and set:
#   CEOP_SQLITE_FILE=/data/ceop.db
#
# When CEOP_SQLITE_FILE is set, run migrations first:
#   node --experimental-strip-types scripts/migrate.ts
# CEOP_SQLITE_FILE=/data/ceop.db

# ─── Persistence: File (alternative, single-node) ────────────────────────────
# JSON-file based persistence. Only used when CEOP_SQLITE_FILE is NOT set.
# Mutually exclusive with CEOP_SQLITE_FILE (SQLite takes priority).
# CEOP_DATA_DIR=/data/ceop-files

# ─── Demo Seeding ─────────────────────────────────────────────────────────────
# Set to "true" to seed demo organisations, users, and roles on first start.
# Safe to enable once on a fresh database; harmless on subsequent starts
# because repositories use upsert semantics.
# Default: "false" (no seeding on persistent stores).
CEOP_SEED_DEMO=false

# ─── Demo Credential Logging (DEVELOPMENT ONLY) ──────────────────────────────
# Set to "true" to print generated API key credentials to stderr on startup.
# NEVER enable in production — credentials belong in a secrets manager.
CEOP_LOG_DEMO_CREDS=false

# Browser E2E stable credential (dev/test only; ignored in production).
# CEOP_E2E_API_KEY_ID=e2e-admin
# CEOP_E2E_API_KEY_SECRET=change-me

# ─── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Global API rate limit (per effective client IP) ────────────────────────
# Behind the Cloudflare Tunnel the socket peer is loopback; the app trusts
# CF-Connecting-IP only when the TCP peer is loopback (see src/api/client-ip.ts).
CEOP_RATE_LIMIT_MAX=300
CEOP_RATE_LIMIT_WINDOW_MS=60000

# ─── Integration Gateway (P1) ────────────────────────────────────────────────
# JSON array of registered integration services exposed through the CEOP
# gateway. Each entry: id / name / baseUrl / pathPrefix / readPermissions /
# writePermissions / timeoutMs (default 10000) / upstreamTokenEnv (optional
# env-var name) / enabled. Upstream tokens are read from the named environment
# variables at request time and are NEVER committed to the repository.
#
# Example (ServiceHub integration service):
# CEOP_GATEWAY_SERVICES=[{"id":"servicehub","name":"ServiceHub","baseUrl":"http://127.0.0.1:8100","pathPrefix":"/api/v1/integrations/servicehub","readPermissions":["integration:read"],"writePermissions":["integration:write"],"timeoutMs":10000,"upstreamTokenEnv":"CEOP_GATEWAY_SERVICEHUB_TOKEN","enabled":true}]
# CEOP_GATEWAY_SERVICEHUB_TOKEN=

# ─── Alert delivery for scripts/health-probe.sh (OPT-IN) ────────────────────
# When set, the probe POSTs {"event":"ALERT|RECOVERED", ...} as JSON to this
# URL on threshold crossing / recovery. Unset = log/exit-code only.
# Set this in cron/service environments; never commit the value.
# CEOP_ALERT_WEBHOOK_URL=https://example.com/hooks/ceop-alert

# ─── Platform identity ───────────────────────────────────────────────────────
PLATFORM_NAME=Construction Enterprise Operating Platform

# ─── CORS (OPT-IN; off by default) ───────────────────────────────────────────
# When set, the API emits Access-Control-Allow-Origin for exactly this origin.
# Leave unset unless a browser-based client on a different origin must call the
# API directly. Never use "*" with authenticated endpoints.
# CEOP_CORS_ORIGIN=https://portal.example.com

# ─── Notification dispatcher (S-09/E-11) ─────────────────────────────────────
# Webhook/Slack 送信先（未設定 = not-configured として失敗記録）。
# CEOP_NOTIFICATION_WEBHOOK_URL=https://example.com/hooks/ceop
# CEOP_NOTIFICATION_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx

# ─── SMTP (E-11 email dispatch) ─────────────────────────────────────────────
# CEOP_SMTP_HOST=smtp.example.com
# CEOP_SMTP_PORT=465
# CEOP_SMTP_SECURE=true
# CEOP_SMTP_USER=
# CEOP_SMTP_PASSWORD=
# CEOP_SMTP_FROM=ceop@example.com

# ─── Metrics (P4) ────────────────────────────────────────────────────────────
# 設定時は GET /metrics に Bearer トークンが必須になる。
# CEOP_METRICS_TOKEN=
# ─── Grafana (P4・compose --profile monitoring) ──────────────────────────────
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=
