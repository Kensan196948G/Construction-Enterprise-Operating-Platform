{
  "name": "construction-eop",
  "version": "0.15.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Construction Enterprise Operating Platform - governance, portal, field OS, and AI governance coordination layer",
  "type": "module",
  "engines": {
    "node": ">=22.6.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.26.2",
  "exports": {
    ".": "./src/index.ts",
    "./domain": "./src/domain/index.ts",
    "./governance": "./src/governance/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "test:watch": "node --test --watch --experimental-strip-types \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-strip-types --experimental-test-coverage \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:logic": "node --test --experimental-strip-types \"tests/domain/**/*.test.ts\" \"tests/golden/**/*.test.ts\"",
    "test:data-quality": "node --test --experimental-strip-types \"tests/data-quality/**/*.test.ts\"",
    "test:security": "node --experimental-strip-types scripts/static-security-scan.ts && node --test --experimental-strip-types tests/security/static-security.test.ts",
    "test:resilience": "node --test --experimental-strip-types \"tests/resilience/**/*.test.ts\"",
    "test:performance": "node --test --experimental-strip-types \"src/api/routes/load-smoke.test.ts\"",
    "test:fuzz": "node --test --experimental-strip-types \"tests/security/*fuzz.test.ts\"",
    "test:ai-eval": "node --test --experimental-strip-types \"tests/ai-eval/**/*.test.ts\"",
    "test:acceptance": "node --experimental-strip-types scripts/validate-acceptance.ts",
    "test:acceptance-contract": "node --test --experimental-strip-types \"tests/acceptance/**/*.test.ts\"",
    "quality:pr": "pnpm run format:check && pnpm run openapi:check && pnpm run typecheck && pnpm run lint && pnpm run test:security && pnpm run test",
    "quality:merge": "pnpm run test:logic && pnpm run test:data-quality && pnpm run test:resilience && pnpm run test:ai-eval && pnpm run test:acceptance-contract",
    "quality:evidence": "node --experimental-strip-types scripts/summarize-test-evidence.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"testdata/**/*.json\" \"examples/**/*.ts\" \"e2e/**\" \"docs/quality/**/*.md\" \"*.json\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"testdata/**/*.json\" \"examples/**/*.ts\" \"e2e/**\" \"docs/quality/**/*.md\" \"*.json\" \"*.md\"",
    "verify": "pnpm run format:check && pnpm run openapi:check && pnpm run typecheck && pnpm run lint && pnpm run test:security && pnpm run test && pnpm run quality:merge && pnpm run build && pnpm run parity",
    "parity": "node --experimental-strip-types scripts/verify-parity.ts",
    "demo": "node --experimental-strip-types examples/quickstart.ts",
    "openapi:gen": "node --experimental-strip-types scripts/generate-openapi.ts",
    "openapi:check": "node --experimental-strip-types scripts/generate-openapi.ts --check",
    "sdk:gen": "node --experimental-strip-types scripts/generate-sdk.ts",
    "favicon:gen": "node --experimental-strip-types scripts/generate-favicon.ts",
    "webui:unpack": "node --experimental-strip-types scripts/webui-unpack.ts",
    "webui:serve": "node --experimental-strip-types scripts/webui-serve.ts",
    "integration:dispatch": "node --experimental-strip-types scripts/run-integration-dispatcher.ts",
    "start": "node --experimental-strip-types scripts/start.ts",
    "start:demo": "node --experimental-strip-types scripts/start-rich-demo.ts",
    "seed:demo": "node --experimental-strip-types scripts/seed-demo.ts",
    "setup": "git config core.hooksPath .githooks && echo '✓ git hooks configured'",
    "pre-commit": "pnpm run format:check && pnpm run lint && pnpm run typecheck"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
      "js-yaml@<4.3.2": "4.3.2"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "js-yaml": "^4.3.2",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.69.0"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "1.17.1"
  }
}
