                  "startLine": 33
                }
              }
            }
          ],
          "message": {
            "text": "Role.scope declares organization/site boundaries, but hasPermission() checks only resource:action permission strings and ApiKeyContext carries no organizationId. Every entity route calls repository-wide findAll/findById/save/delete without a tenant predicate, so an org-scoped key with device:write (for example) can list, create, and update devices in every organization, and the same holds for users, workflows, applications, and audit records."
          },
          "partialFingerprints": {
            "codexSecurity/v1": "codex-security/v1:sha256:7a5053a3eb851e0cc39e55b4dab0ef5195e56e9cfbbf08e66bec4c31fcc819d1",
